    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Stage1: run_stage1 (module, defaults)",
            "type": "debugpy",
            "request": "launch",
            "module": "socialclaw.stage1.run_stage1",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "args": [
                "--prepared",
                "data/pbench/prepared/all.jsonl",
                "--base-url",
                "https://openrouter.ai/api/v1",
                "--model",
                "moonshotai/kimi-k2.6",
                "--max-problems",
                "5",
                "--max-iters",
                "2"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}